{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beryl.dev/schemas/brpl-v2-tests.schema.json",
  "title": "Prospective BRPL v2 policy tests",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "tests"],
  "properties": {
    "apiVersion": {"const": "beryl.dev/brpl-tests/v2"},
    "kind": {"const": "PolicyTestSuite"},
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "evidence", "expect"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "brpl-v2-evidence.schema.json"},
          "expect": {"type": "object", "additionalProperties": false, "required": ["violations"], "properties": {"violations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}}}}
        }
      }
    }
  }
}
