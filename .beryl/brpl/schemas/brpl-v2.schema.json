{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beryl.dev/schemas/brpl-v2.schema.json",
  "title": "Prospective BRPL v2 policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "beryl.dev/brpl/v2"},
    "kind": {"enum": ["RepositoryPolicy", "TaskPolicy"]},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}}
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules"],
      "properties": {
        "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\).+$"},
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "remediation": {"enum": ["remove_change", "move_change", "change_dependency", "run_required_check", "recheck_candidate", "restore_trusted_control", "preserve_gate_decision", "stop_and_report"]},
    "envelope": {
      "type": "object",
      "required": ["id", "kind", "severity"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["change.paths", "change.protect", "dependency.forbid", "manifest.direct_dependencies", "check.require"]},
        "severity": {"enum": ["error", "warning"]},
        "remediation": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "oneOf": [
        {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "remediation", "effect", "paths"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "change.paths"}, "severity": {"enum": ["error", "warning"]}, "remediation": {"$ref": "#/$defs/remediation"}, "effect": {"enum": ["allow", "deny"]}, "paths": {"$ref": "#/$defs/strings"}}}]},
        {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "remediation", "paths"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "change.protect"}, "severity": {"enum": ["error", "warning"]}, "remediation": {"$ref": "#/$defs/remediation"}, "paths": {"$ref": "#/$defs/strings"}}}]},
        {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "remediation", "relation", "source", "target"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "dependency.forbid"}, "severity": {"enum": ["error", "warning"]}, "remediation": {"$ref": "#/$defs/remediation"}, "relation": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/path"}, "target": {"$ref": "#/$defs/path"}}}]},
        {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "remediation", "manifest", "allow_add", "allow_remove"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "manifest.direct_dependencies"}, "severity": {"enum": ["error", "warning"]}, "remediation": {"$ref": "#/$defs/remediation"}, "manifest": {"$ref": "#/$defs/path"}, "allow_add": {"$ref": "#/$defs/strings"}, "allow_remove": {"$ref": "#/$defs/strings"}}}]},
        {"allOf": [{"$ref": "#/$defs/envelope"}, {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "remediation", "checks"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"const": "check.require"}, "severity": {"enum": ["error", "warning"]}, "remediation": {"$ref": "#/$defs/remediation"}, "checks": {"$ref": "#/$defs/strings"}}}]}
      ]
    }
  }
}
